class Solution {
    public int climbStairs(int n) {
        return climbBu(n);
    }

    private int climbBu(int stairs) {
        if (stairs <= 2) {
            return stairs;
        }

        int[] poss = new int[stairs + 1];
        poss[1] = 1;
        poss[2] = 2;

        for (int i = 3; i <= stairs; i++) {
            poss[i] = poss[i - 1] + poss[i - 2];
        }

        return poss[stairs];
    }
}
