import java.util.ArrayList;
import java.util.TreeSet;

class Solution {
    public ArrayList<Integer> mergeNsort(int[] arr1, int[] arr2) {
        TreeSet<Integer> set = new TreeSet<>();
        
        for (int num : arr1) {
            set.add(num);
        }
        
        for (int num : arr2) {
            set.add(num);
        }
        
        return new ArrayList<>(set);
    }
}
