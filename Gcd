class Solution {

    public long maxPairStrength(int[] nums) {
        long ans = 0;
        int n = nums.length;

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int g = gcd(nums[i], nums[j]);
                long strength = ((long) nums[i] / g) * ((long) nums[j] / g);
                ans = Math.max(ans, strength);
            }
        }

        return ans;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }
}©leetcode
