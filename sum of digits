import java.util.Scanner;

class Codechef {
    public static void main(String[] args) throws java.lang.Exception {
        Scanner sc = new Scanner(System.in);
        
        if (sc.hasNextInt()) {
            int t = sc.nextInt();
            
            while (t-- > 0) {
                int n = sc.nextInt();
                int sum = 0;
                
                while (n > 0) {
                    sum += n % 10;
                    n /= 10;
                }
                
                System.out.println(sum);
            }
        }
        
        sc.close();
    }
}
